EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Android emulator: http://10.0.2.2:3001 | Physical device: use your Mac LAN IP | Web/iOS simulator: http://localhost:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
# Required for Google Maps tiles in Android production/development builds. iOS uses Apple Maps by default.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
